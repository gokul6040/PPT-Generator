# Choose one: azure_anthropic, azure_openai, or openai
LLM_PROVIDER=azure_openai

# Azure Anthropic (required only when LLM_PROVIDER=azure_anthropic)
AZURE_ANTHROPIC_ENDPOINT=
AZURE_ANTHROPIC_API_KEY=
AZURE_ANTHROPIC_MODEL=claude-sonnet-4-6
AZURE_ANTHROPIC_API_VERSION=2023-06-01
AZURE_ANTHROPIC_MAX_TOKENS=4096

# Azure OpenAI (required only when LLM_PROVIDER=azure_openai)
AZURE_OPENAI_ENDPOINT=
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_DEPLOYMENT=
AZURE_OPENAI_API_VERSION=2024-02-15-preview

# OpenAI (required only when LLM_PROVIDER=openai)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o

# Azure Blob Storage (required for templates, uploads, and generated decks)
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=turnb-ppt
AZURE_STORAGE_TEMPLATE_BLOB=templates/sample_template.pptx

# Microsoft Teams bot (required only when using the Teams bot at /api/messages)
# Leave APP_ID blank for local Bot Framework Emulator testing.
# APP_TYPE: MultiTenant | SingleTenant | UserAssignedMSI
MICROSOFT_APP_ID=
MICROSOFT_APP_PASSWORD=
MICROSOFT_APP_TYPE=MultiTenant
MICROSOFT_APP_TENANT_ID=
